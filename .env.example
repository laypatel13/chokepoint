FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# OpenAI-compatible LLM endpoint (Ollama locally, Gemini/Groq when deployed)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b
# Fine-grained token scoped to our demo fork ONLY
GITHUB_TOKEN=
GITHUB_DEMO_REPO=
# Set to "none" to disable thinking on local models (faster). Leave empty for Groq/Gemini.
LLM_REASONING_EFFORT=none
