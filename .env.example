FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# OpenAI-compatible LLM endpoint (Ollama locally, Gemini/Groq when deployed)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b
# Fine-grained token scoped to our demo fork ONLY
GITHUB_TOKEN=
GITHUB_DEMO_REPO=
# Local models only (Ollama): "none" turns off thinking, 2x faster. Keep it EMPTY for Groq/Gemini/OpenAI,
# which reject the setting.
LLM_REASONING_EFFORT=
